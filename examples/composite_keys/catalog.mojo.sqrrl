@@struct @@Publisher:
    name: String

@@struct @@Series:
    key(name, start_year)
    name: String
    start_year: Int
    @@publisher: @@Publisher

@@struct @@Booking:
    key(room, date)
    key(guest, date)
    room: String
    date: String
    guest: String

def main() raises:
    @@@:
        var @@acme = @@@Publisher { .name = "Acme Press" }
        var @@series1 = @@@Series { .name = "Foundation", .start_year = 1951, .@@publisher = @@acme }

        # key(...) raises on a genuine collision -- it does NOT get-or-
        # create the way a whole-entity `value` match does (a *subset*
        # match doesn't make the rest of the incoming row's data safely
        # discardable, since a real Series with a different publisher
        # could otherwise be silently dropped).
        var duplicate_raised = False
        try:
            _ = @@@Series.create(name = "Foundation", start_year = 1951, @@publisher = @@acme)
        except:
            duplicate_raised = True
        print("duplicate (name, start_year) correctly rejected:", duplicate_raised)

        # A *partial* match -- same name, different start_year -- is a
        # different combination for this key group, so it's fine.
        var @@series2 = @@@Series { .name = "Foundation", .start_year = 1985, .@@publisher = @@acme }
        print("partial match allowed:", @@series1.name, @@series1.start_year, @@series2.start_year)

        # The generated composite lookup -- mirrors a single `unique`
        # field's own for_<field>, just over the whole (name, start_year)
        # tuple at once.
        var @@found_series = @@@Series.for_name_start_year("Foundation", 1951)
        print("found via composite lookup:", @@found_series.name, @@found_series.start_year)

        # `Booking` declares *two* independent key(...) groups sharing a
        # field (`date`) -- each is checked and maintained on its own.
        var @@booking1 = @@@Booking { .room = "101", .date = "2026-08-01", .guest = "Alice" }

        var room_date_raised = False
        try:
            _ = @@@Booking.create(room = "101", date = "2026-08-01", guest = "Bob")
        except:
            room_date_raised = True
        print("room+date collision rejected even with a different guest:", room_date_raised)

        var guest_date_raised = False
        try:
            _ = @@@Booking.create(room = "202", date = "2026-08-01", guest = "Alice")
        except:
            guest_date_raised = True
        print("guest+date collision rejected even with a different room:", guest_date_raised)

        # Neither the room nor the guest nor the date alone collides with
        # booking1 -- both groups' constraints are satisfied, so this
        # succeeds.
        var @@booking2 = @@@Booking { .room = "202", .date = "2026-08-02", .guest = "Carol" }

        var @@found_booking = @@@Booking.for_room_date("101", "2026-08-01")
        print("found booking via room+date lookup:", @@found_booking.guest)
        var @@found_by_guest = @@@Booking.for_guest_date("Carol", "2026-08-02")
        print("found booking via guest+date lookup:", @@found_by_guest.room)

        print(
            "keep alive:",
            @@series1.name, @@series2.name, @@booking1.guest, @@booking2.guest,
            @@found_series.name, @@found_booking.guest, @@found_by_guest.room,
        )
