@@struct @@Publisher:
    title: String

@@struct @@Series:
    title: String
    start_year: Int
    @@publisher: @@Publisher
    key(title, start_year)

    def describe(self) -> String:
        return self.title + " (" + String(self.start_year) + ")"

@@struct @@VolumeSeries < @@Series:
    pass

@@struct @@Arc:
    title: String
    @@series: @@Series

struct SourceArcPart:
    var @@arc: @@Arc
    var part: String

@@struct keepalive @@Issue:
    title: Optional[String]
    source: Variant[SourceArcPart, @@Series]
    no: Int

@@struct keepalive @@Volume:
    source: Variant[@@Arc, @@VolumeSeries]
    multi @@issues: @@Issue
    no: Int

# Ownership as its own entity, not a flag on @@Issue/@@Volume directly --
# existence of a matching row *is* "owned"; there's no explicit "not
# owned" state to maintain. `unique item` enforces at most one @@Owned row
# per Issue/Volume (can't double-own the same item), and its own
# Variant[@@Volume, @@Issue] lets one table cover both ownable kinds.
# `keepalive` because nothing else ever holds a forward reference *to* an
# @@Owned row (it only ever points *at* an Issue/Volume, never the other
# way) -- unlike @@Series/@@Publisher/@@Arc, which stay alive transitively
# through @@Issue's own forward fields, an @@Owned row's only chance of
# surviving past its own local variable's last use is this tag.
@@struct keepalive @@Owned:
    unique item: Variant[@@Volume, @@Issue]

def main() raises:
    @@@:
        var @@acme = @@@Publisher { .title = "Acme Press" }

        var @@series = @@@Series.create(title = "Foundation", start_year = 1951, @@publisher = @@acme)
        print("series describe (own method):", @@series.describe())

        # `< @@Series` copies title/start_year/@@publisher/key(title,
        # start_year)/describe() into VolumeSeries verbatim 
        var @@volume = @@@VolumeSeries.create(title = "Foundation", start_year = 1951, @@publisher = @@acme)
        print("volume series describe (inherited method):", @@volume.describe())
        
        # Purely structural, not polymorphic -- separate tables, separate
        # id spaces, separate counts, even with identical title/start_year.
        print("series count:", @@@Series.count())
        print("volume series count:", @@@VolumeSeries.count())

        # The inherited key(title, start_year) group earns its own
        # composite lookup on VolumeSeries too.
        var @@found_volume = @@@VolumeSeries.for_title_start_year("Foundation", 1951)
        print("found volume series via inherited composite lookup:", @@found_volume.title)

        # create() raises on a genuine collision -- inherited from Series,
        # enforced independently of Series's own key(title, start_year).
        var volume_duplicate_raised = False
        try:
            _ = @@@VolumeSeries.create(title = "Foundation", start_year = 1951, @@publisher = @@acme)
        except:
            volume_duplicate_raised = True
        print("volume series duplicate (title, start_year) correctly rejected:", volume_duplicate_raised)

        # A VolumeSeries with a different (title, start_year) doesn't
        # collide with Series's own row, or with the first VolumeSeries.
        var @@volume2 = @@@VolumeSeries.create(title = "Second Foundation", start_year = 1953, @@publisher = @@acme)
        print("second volume series count:", @@@VolumeSeries.count())

        var @@arc = @@@Arc { .title = "The Mule", .@@series = @@series }
        print("arc's series:", @@arc.@@series.title)



        var @@issue = @@@Issue {
            .title = "Issue 1",
            .source = Variant[SourceArcPart, @@Series]({ .@@arc = @@arc, .part = "The part" }),
            .no = 1,
        }
        print("issue number:", @@issue.no)
        var @@issue_owned = @@@Owned { .item = Variant[@@Volume, @@Issue](@@issue) }
        print("issue owned:", @@issue_owned.item.isa[@@Issue]())

        # A collection tracker needs wishlist items too -- catalogued, no
        # matching @@Owned row (yet).
        var @@issue2 = @@@Issue {
            .title = "Issue 2",
            .source = Variant({ .@@arc = @@arc, .part = "The other part" }),
            .no = 2,
        }
        print("issue 1 owned:", @@@Owned.count_for_item(Variant[@@Volume, @@Issue](@@issue)) > 0)
        print("issue 2 owned:", @@@Owned.count_for_item(Variant[@@Volume, @@Issue](@@issue2)) > 0)

        # @@Volume ties a single-book-or-series source (Variant[@@Arc,
        # @@VolumeSeries]) together with the issues collected under it
        # (multi @@issues) -- here sourced from the VolumeSeries created
        # above.
        var @@vol1 = @@@Volume {
            .source = Variant[@@Arc, @@VolumeSeries](@@volume),
            .@@issues = Set(@@issue),
            .no = 1,
        }
        var @@volume_wishlist = @@@Volume {
            .source = Variant[@@Arc, @@VolumeSeries](@@volume),
            .@@issues = Set(@@issue),
            .no = 2,
        }
        var @@vol1_owned = @@@Owned { .item = Variant[@@Volume, @@Issue](@@vol1) }
        print("book volume issue count:", @@@Volume.count_for_@@issues(@@issue))
        print("total owned items:", @@@Owned.count())

        # Acquiring a wishlist volume -- creating its own @@Owned row, not
        # flipping a flag; there's nothing to "un-acquire" to, since not
        # owning something is just the absence of a row.
        var @@volume_wishlist_owned = @@@Owned { .item = Variant[@@Volume, @@Issue](@@volume_wishlist) }
        print("total owned items after acquiring the wishlist copy:", @@@Owned.count())

        var no = @@vol1_owned.item.unsafe_get[@@Volume]().(@@Volume).no
        print(
            "keep alive:",
            @@series.title, @@volume.title, @@volume2.title,
            @@found_volume.title, @@arc.title, @@issue.no, @@issue2.no,
            @@issue_owned.item.isa[@@Issue](), @@vol1_owned.item.isa[@@Volume](),
            @@volume_wishlist_owned.item.isa[@@Volume](),
            no
        )

        var s = @@@to_json()

        @@@init_from_json(s)

        print(s)
